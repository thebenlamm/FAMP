#!/usr/bin/env bash
# Background monitor for listen mode.
#
# Parks on the FAMP bus and prints one `FAMP_WAKE identity=… sender=… count=…`
# line per inbound message. Claude Code delivers each stdout line to the model
# as a notification, which is what lets this replace the 86400-second Stop-hook
# await used by the standalone install.
#
# Started by monitors/monitors.json with `"when": "on-skill-invoke:listen"`, so
# it only runs after the user has invoked /famp:listen — by which point an
# identity is registered and resolvable.
set -euo pipefail

IDENTITY="${FAMP_LOCAL_IDENTITY:-}"

if [ -z "$IDENTITY" ]; then
  # `famp whoami` emits a JSON line: {"active":"alice","joined":[]}
  IDENTITY="$(famp whoami 2>/dev/null \
    | sed -n 's/.*"active":"\([^"]*\)".*/\1/p' \
    | head -1 || true)"
fi

if [ -z "$IDENTITY" ]; then
  echo "FAMP_WAKE_ERROR no identity bound — run /famp:register <name> first, then /famp:listen"
  exit 1
fi

# --loop: flush a line per wake, then re-await. Timeouts re-await silently.
exec famp listen-wake --as "$IDENTITY" --loop
